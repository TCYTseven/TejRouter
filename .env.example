# TejRouter reads these server-side only. Copy to .env.local and fill in what you have.
# Any router without a key is shown as "not configured"; the two offline simulators always work.

# Ramp Router (https://github.com/ramp-public/ramp-cli)
RAMP_ROUTER_API_KEY=
# RAMP_ROUTER_BASE_URL=https://api.router.com/v1
# RAMP_ROUTER_MODEL=

# Enclave Cyberouter (https://router.enclave.ai)
ENCLAVE_ROUTER_API_KEY=
# ENCLAVE_ROUTER_BASE_URL=https://router.enclave.ai/v1
# ENCLAVE_ROUTER_MODEL=cyberouter/auto

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# Requesty (https://requesty.ai): routing is a named policy, e.g. policy/my-policy
REQUESTY_API_KEY=
# REQUESTY_MODEL=

# FastLLM (https://fastllm.azrty.com/) is self-hosted: point at your deployment
FASTLLM_BASE_URL=
FASTLLM_API_KEY=
FASTLLM_MODEL=

# Martian (base URL and model id unverified; override if needed)
MARTIAN_API_KEY=
# MARTIAN_BASE_URL=https://api.withmartian.com/v1
# MARTIAN_MODEL=

# Any other OpenAI-compatible router
CUSTOM_ROUTER_BASE_URL=
CUSTOM_ROUTER_API_KEY=
CUSTOM_ROUTER_MODEL=

# Optional: require HTTP Basic auth (any username, this password) for every page and API call.
# Set this whenever the app is reachable by anyone but you; the API spends your router credits.
# TEJROUTER_PASSWORD=
# Optional: public URL used for canonical links, sitemap and Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://tejrouter.example.com
# Optional: where benchmark runs are saved (default ./data/runs).
# TEJROUTER_RUNS_DIR=
