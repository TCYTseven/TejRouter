{
  "name": "tejrouter",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark LLM routers from the terminal or CI: which model each router picked, latency, cost, accuracy and whether the differences are real.",
  "license": "MIT",
  "author": "Tejas Chakrapani",
  "homepage": "https://github.com/TCYTseven/TejRouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TCYTseven/TejRouter.git"
  },
  "bugs": {
    "url": "https://github.com/TCYTseven/TejRouter/issues"
  },
  "keywords": [
    "llm",
    "llm-router",
    "benchmark",
    "openrouter",
    "ai-gateway",
    "evaluation",
    "nextjs",
    "cli",
    "ci"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "tejrouter": "dist/tejrouter.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "prepare": "node scripts/build-cli.mjs",
    "cli": "node scripts/build-cli.mjs && node dist/tejrouter.mjs",
    "bench": "npm run -s cli -- bench"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
